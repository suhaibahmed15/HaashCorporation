# Haash Corporation Environment Configuration
# Copy this file to .env and configure your production credentials

# Server configuration
PORT=3000
NODE_ENV=development

# Email Delivery Configuration (Resend API)
# Get your API key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Contact Form Recipient & Sender
# In production, CONTACT_SENDER_EMAIL must be verified in your email provider domain (e.g., inquiries@haashcorp.com)
CONTACT_RECIPIENT_EMAIL=Suhaibahmed099@gmail.com
CONTACT_SENDER_EMAIL=website@haashcorp.com

# WhatsApp International Phone Number (Format: country code + number with no +, -, or spaces)
WHATSAPP_PHONE_NUMBER=923423951603

# Social Media Profile URLs
FACEBOOK_PAGE_URL=https://www.facebook.com/HasshCorporation
INSTAGRAM_PAGE_URL=https://www.instagram.com/hasshcorporation
LINKEDIN_PAGE_URL=https://www.linkedin.com/company/haashcorporation
